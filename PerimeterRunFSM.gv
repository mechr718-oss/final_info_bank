digraph PerimeterRun {
    rankdir=TB;
    init [shape="point", color="black", style="filled", width=.1];
    node [shape=box, style=rounded];
    StartCheck [shape=diamond];
    PERIMETER_FOUND [shape=hexagon, label="return PERIMETER_FOUND\n(brake, clockwise)"];
    LINE_LOST [shape=hexagon, label="return LINE_LOST"];
    subgraph cluster_top { label="TopHSM (runs forever)";
        WaitToStart; FindPerimeter; FollowPerimeter;
    }
    init -> WaitToStart [label=<<u>ES_INIT [!brownout]</u>>];
    init -> FindPerimeter [style=dashed, label=<<u>ES_INIT [brownout]</u><br/><i>start in FollowUnknown</i>>];
    WaitToStart -> FindPerimeter [label=<<u>TOP_TIMER</u>>];
    FindPerimeter -> StartCheck [label=<<u>sub entry</u>>];
    PERIMETER_FOUND -> FollowPerimeter [label=<<u>PERIMETER_FOUND</u><br/><i>fieldOnRight = TRUE</i>>];
    FollowPerimeter -> OnLine [label=<<u>sub entry</u>>];
    LINE_LOST -> FindPerimeter [label=<<u>LINE_LOST</u>>];
    OnLine -> OnLine [label=<<u>TAPE [aligned = FC+BC only]</u><br/><i>base speed + trim</i>>];
    OnLine -> SteerLeft [label=<<u>TAPE [FL, !FC]</u>>];
    OnLine -> SteerRight [label=<<u>TAPE [FR, !FC]</u>>];
    SteerLeft -> OnLine [label=<<u>TAPE [FC]</u>>];
    SteerRight -> OnLine [label=<<u>TAPE [FC]</u>>];
    SteerLeft -> SteerRight [label=<<u>TAPE [FR, !FC]</u>>];
    SteerRight -> SteerLeft [label=<<u>TAPE [FL, !FC]</u>>];
    OnLine -> CornerCreep [label=<<u>TAPE [FC + F_FIELD]</u>>];
    CornerCreep -> TurnCorner [label=<<u>FOLLOW_TIMER</u><br/><i>CORNER_CREEP_IN</i>>];
    TurnCorner -> OnLine [label=<<u>TAPE [FC]</u>>];
    TurnCorner -> LostLine [label=<<u>FOLLOW_TIMER [120 deg]</u>>];
    OnLine -> LostLine [label=<<u>TAPE [front all off]</u>>];
    SteerLeft -> LostLine [label=<<u>front off / 1 s</u>>];
    SteerRight -> LostLine [label=<<u>front off / 1 s</u>>];
    LostLine -> Realign [label=<<u>TAPE [any on]</u>>];
    Realign -> OnLine [label=<<u>TAPE [FC]</u>>];
    LostLine -> LINE_LOST [label=<<u>6 in reversed</u>>];
    Realign -> LINE_LOST [label=<<u>60 deg</u>>];
    StartCheck -> Kick [label=<<u>FC &amp;&amp; BC</u>>];
    StartCheck -> Seek [label=<<u>else (bare floor)</u>>];
    Kick -> FollowUnknown [label=<<u>FIND_PERIM_TIMER</u>>];
    FollowUnknown -> Seek [label=<<u>TAPE [FL,FC,FR all off]</u><br/><i>Arm_tip, onPerimeter = TRUE</i>>];
    FollowUnknown -> Check [label=<<u>TAPE [CR &amp;&amp; !backBlind]</u>>];
    FollowUnknown -> FollowUnknown [label=<<u>TAPE [else]</u><br/><i>BackBlindCheck, UpdateTarget</i>>];
    Check -> CrossThrough [label=<<u>TAPE [FL &amp;&amp; FC]</u>>];
    Check -> CornerBackup [label=<<u>TAPE [!FC]</u><br/><i>Corner_FC_off</i>>];
    Check -> FollowUnknown [label=<<u>TAPE [!CR]</u><br/><i>Check_false_CR</i>>];
    CrossThrough -> CrossArm [label=<<u>TAPE [!FL &amp;&amp; !FR &amp;&amp; FC]</u><br/><i>Cross_confirmed</i>>];
    CrossThrough -> CornerBackup [label=<<u>TAPE [!FC]</u><br/><i>Corner_after_all</i>>];
    CrossArm -> Seek [label=<<u>TAPE [FL,FC,FR all off]</u><br/><i>Arm_tip, onPerimeter = TRUE</i>>];
    CrossArm -> CrossArm [label=<<u>TAPE [else]</u><br/><i>CrossBackBlind, UpdateTarget</i>>];
    Seek -> AcquirePreSwing [label=<<u>TAPE [CR]</u>>];
    Seek -> AcquireSwing [label=<<u>TAPE [FL &amp;&amp; FC &amp;&amp; FR &amp;&amp; !CR]</u><br/><i>Seek_no_CR</i>>];
    CornerBackup -> CornerBackup [label=<<u>TAPE [CR]</u><br/><i>crSeen = TRUE</i>>];
    CornerBackup -> AcquirePreSwing [label=<<u>TAPE [!CR &amp;&amp; crSeen]</u><br/><i>brake</i>>];
    AcquirePreSwing -> AcquireSwing [label=<<u>FIND_PERIM_TIMER</u>>];
    AcquireSwing -> AcquireSwing [label=<<u>TAPE [!FC]</u><br/><i>fcSeenOff = TRUE</i>>];
    AcquireSwing -> AcquireSwingExtra [label=<<u>TAPE [FC &amp;&amp; fcSeenOff &amp;&amp; half SWING_MS]</u><br/><i>Swing_FC_on</i>>];
    AcquireSwing -> AcquireSwingExtra [label=<<u>FIND_PERIM_TIMER</u><br/><i>Swing_time</i>>];
    AcquireSwingExtra -> PERIMETER_FOUND [label=<<u>FIND_PERIM_TIMER [onPerimeter]</u><br/><i>brake</i>>];
    AcquireSwingExtra -> Kick [label=<<u>FIND_PERIM_TIMER [!onPerimeter]</u><br/><i>brake, backBlind = TRUE</i>>];
}
